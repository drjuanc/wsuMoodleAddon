{
  "manifest_version": 3,
  "name": "IWS Moodle Helper",
  "version": "2.0",
  "description": "Hides the 'Chat to Wale' widget and cleans text pasted from MS Word into Moodle editors at IWS. Each feature can be switched on or off from the toolbar popup.",
  "author": "Dr Juan Carlos Garcia-Alonso",
  "homepage_url": "https://github.com/drjuanc/wsuMoodleAddon",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "IWS Moodle Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.wsu.ac.za/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://wiseup.wsu.ac.za/*"],
      "js": ["paste-clean.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["https://wiseup.wsu.ac.za/question/bank/importquestions/import.php*"],
      "js": ["lib/jszip.min.js", "importer/docx-parse.js", "importer/moodle-xml.js", "importer/importer.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://wiseup.wsu.ac.za/question/bank/importquestions/import.php*"],
      "js": ["importer/dropper.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "wsu-moodle-helper@drjuanc.github.io",
      "strict_min_version": "128.0"
    }
  }
}