{
  "manifest_version": 3,
  "name": "WiSeUp Toolkit",
  "version": "2.0",
  "description": "Hides the 'Chat to Wale' widget, cleans text pasted from MS Word and imports MCQs from Word documents on IWS's WiSeUp Moodle.",
  "author": "Dr Juan Carlos Garcia-Alonso",
  "homepage_url": "https://github.com/drjuanc/wsuMoodleAddon",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "WiSeUp Toolkit",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.wsu.ac.za/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://wiseup.wsu.ac.za/*"],
      "js": ["paste-clean.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["https://wiseup.wsu.ac.za/question/bank/importquestions/import.php*"],
      "js": ["lib/jszip.min.js", "importer/docx-parse.js", "importer/moodle-xml.js", "importer/importer.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://wiseup.wsu.ac.za/question/bank/importquestions/import.php*"],
      "js": ["importer/dropper.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "wsu-moodle-helper@drjuanc.github.io",
      "strict_min_version": "128.0"
    }
  }
}